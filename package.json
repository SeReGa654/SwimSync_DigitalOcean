{
  "name": "swimsync",
  "private": true,
  "workspaces": ["backend", "frontend", "shared-contracts"],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:docx": "powershell -NoProfile -Command \"$listener = Get-NetTCPConnection -State Listen -ErrorAction SilentlyContinue | Where-Object { $_.LocalPort -eq 3012 } | Select-Object -First 1; if ($listener) { try { Stop-Process -Id $listener.OwningProcess -Force -ErrorAction Stop } catch {} }; Set-Location docx-service; py -m uvicorn main:app --host 0.0.0.0 --port 3012 --reload\"",
    "dev:docx:worker": "cd docx-service && py worker.py",
    "dev:full": "concurrently -n \"BACKEND,FRONTEND,DOCS,STUDIO\" -c \"bgBlue,bgGreen,bgMagenta,bgCyan\" \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:docx\" \"npm run db:studio\"",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "db:push": "cd backend && npx prisma db push",
    "db:push:pg": "cd backend && npm run db:push:pg",
    "db:generate:pg": "cd backend && npm run db:generate:pg",
    "db:migrate:dev": "cd backend && npm run db:migrate:dev",
    "db:migrate:deploy": "cd backend && npm run db:migrate:deploy",
    "db:migrate:status": "cd backend && npm run db:status",
    "db:seed": "cd backend && npx prisma db seed",
    "db:studio": "cd backend && npx prisma studio",
    "setup": "npm install && npm run db:push && npm run db:seed",
    "infra:up": "docker compose -f docker-compose.infra.yml up -d",
    "infra:down": "docker compose -f docker-compose.infra.yml down",
    "app:up": "docker compose -f docker-compose.app.yml up -d --build",
    "app:up:doppler": "doppler run --command \"docker compose -f docker-compose.app.yml up -d --build\"",
    "app:down": "docker compose -f docker-compose.app.yml down",
    "app:up:prod": "docker compose -f docker-compose.production.yml --env-file .env.production up -d --build",
    "app:down:prod": "docker compose -f docker-compose.production.yml --env-file .env.production down",
    "app:pull:prod": "docker compose -f docker-compose.production.yml --env-file .env.production pull",
    "app:logs:prod": "docker compose -f docker-compose.production.yml --env-file .env.production logs -f --tail=200",
    "prod:first-deploy": "bash ops/scripts/prod-first-deploy.sh",
    "prod:update": "bash ops/scripts/prod-update.sh",
    "prod:rollback": "bash ops/scripts/prod-rollback.sh",
    "prod:backup": "bash ops/scripts/prod-backup.sh",
    "prod:restore": "bash ops/scripts/prod-restore.sh",
    "prod:restart": "bash ops/scripts/prod-restart.sh",
    "prod:healthcheck": "bash ops/scripts/prod-healthcheck.sh",
    "prod:certbot:renew": "bash ops/scripts/prod-certbot-renew.sh",
    "backend:openapi": "npm --prefix backend run openapi:generate",
    "contracts:generate": "npm run backend:openapi && openapi-typescript backend/openapi.json -o shared-contracts/src/generated/openapi.ts",
    "test:quick": "npm --prefix backend test && npm --prefix frontend test && npm run test:docx",
    "smoke:fullstack": "node ops/scripts/smoke-fullstack.mjs",
    "smoke:named-application": "node ops/scripts/smoke-named-application-flow.mjs",
    "test:docx": "pytest docx-service/tests -q",
    "audit:prod": "node ops/scripts/audit-prod-deps.mjs",
    "test:load:api": "k6 run ops/k6/api-load.js",
    "test:load:live": "k6 run ops/k6/live-ws-load.js",
    "backup:sqlite": "powershell -ExecutionPolicy Bypass -File ops/scripts/backup-sqlite.ps1",
    "restore:sqlite": "powershell -ExecutionPolicy Bypass -File ops/scripts/restore-sqlite.ps1",
    "backup:pg": "powershell -ExecutionPolicy Bypass -File ops/scripts/backup-postgres.ps1",
    "restore:pg": "powershell -ExecutionPolicy Bypass -File ops/scripts/restore-postgres.ps1",
    "drill:recovery": "powershell -ExecutionPolicy Bypass -File ops/scripts/drill-recovery.ps1",
    "drill:recovery:schedule": "powershell -ExecutionPolicy Bypass -File ops/scripts/register-recovery-drill-task.ps1",
    "drill:recovery:unschedule": "powershell -ExecutionPolicy Bypass -File ops/scripts/unregister-recovery-drill-task.ps1",
    "ops:check-migration-guardrails": "node ops/scripts/check-migration-guardrails.mjs",
    "ops:check-deploy-readiness": "node ops/scripts/check-deploy-readiness.mjs",
    "ops:check-prod-env": "node ops/scripts/check-prod-env.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "openapi-typescript": "^7.10.1"
  },
  "overrides": {
    "fast-uri": "^3.1.2",
    "postcss": "^8.5.10",
    "tmp": "0.2.6",
    "next": {
      "postcss": "^8.5.10"
    }
  }
}
