{
  "name": "swimsync-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build && npm run build:seed",
    "build:seed": "tsc -p prisma/tsconfig.seed.json",
    "start": "nest start",
    "start:dev": "ts-node src/main.ts",
    "start:prod": "node dist/backend/src/main",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:unit": "ts-node tests/run-tests.ts",
    "test:unit:coverage": "c8 --check-coverage --lines 20 --functions 20 --branches 10 --statements 20 --reporter=text-summary ts-node tests/run-tests.ts",
    "test": "npm run typecheck && npm run test:unit",
    "smoke": "node scripts/smoke-check.mjs",
    "openapi:generate": "ts-node scripts/generate-openapi.ts",
    "backfill:result-protocol-config": "ts-node scripts/backfill-result-protocol-config.ts",
    "backfill:result-protocol-config:apply": "ts-node scripts/backfill-result-protocol-config.ts --apply",
    "bench:advanced-grouping": "ts-node scripts/benchmark-advanced-grouping.ts",
    "db:generate:pg": "prisma generate",
    "db:push:pg": "prisma db push",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed:prod": "node dist/prisma/seed.js"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/platform-socket.io": "^11.1.3",
    "@nestjs/websockets": "^11.1.3",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "exceljs": "^4.4.0",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.2",
    "papaparse": "^5.5.3",
    "prom-client": "^15.1.3",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "shared-contracts": "*",
    "swagger-ui-express": "^5.0.1",
    "tmp": "0.2.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.5",
    "@types/express": "^5.0.3",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "c8": "^10.1.3",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2"
  }
}
