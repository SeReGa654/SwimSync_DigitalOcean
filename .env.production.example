# Deployment target
APP_DOMAIN=swimsync.example.com
LETSENCRYPT_EMAIL=ops@example.com
NEXT_PUBLIC_WS_URL=https://swimsync.example.com

# Postgres / Redis
POSTGRES_DB=swimsync
POSTGRES_USER=swimsync
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://swimsync:change-me-strong-password@postgres:5432/swimsync?schema=public&connection_limit=20&pool_timeout=20
REDIS_URL=redis://redis:6379
DOCX_REDIS_URL=redis://redis:6379

# Backend (production-safe)
BACKEND_PORT=3001
TRUST_PROXY_HOPS=1
FRONTEND_URL=https://swimsync.example.com
DOCX_SERVICE_URL=http://docx-service:3012
DOCX_REQUEST_TIMEOUT_MS=30000
DOCX_USE_QUEUE=true
DOCX_QUEUE_POLL_INTERVAL_MS=500
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_LOGIN_RATE_LIMIT_MAX=20
EXPORT_RATE_LIMIT_MAX=120
ADMIN_COOKIE_NAME=admin_token
ADMIN_COOKIE_MAX_AGE_MS=43200000
ADMIN_COOKIE_PATH=/
AUTH_ROLE_COOKIE_NAME=auth_role
CSRF_COOKIE_NAME=csrf_token
ADMIN_COOKIE_SAME_SITE=none
ADMIN_COOKIE_SECURE=true
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=change-me-bootstrap-password

# Frontend
BACKEND_API_URL=http://backend:3001

# DOCX service
LOG_LEVEL=INFO
DOCX_JOB_TTL_SEC=900
DOCX_JOB_MAX_RETRIES=3
DOCX_REDIS_QUEUE_KEY=swimsync:docx:queue
DOCX_REDIS_DEAD_LETTER_KEY=swimsync:docx:dead-letter
DOCX_REDIS_JOB_PREFIX=swimsync:docx:job
DOCX_REDIS_IDEMP_PREFIX=swimsync:docx:idempotency
DOCX_INTERNAL_WORKER=true
CORS_ALLOW_ORIGINS=https://swimsync.example.com
