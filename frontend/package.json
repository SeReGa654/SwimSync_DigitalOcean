{
  "name": "swimsync-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "set \"NODE_ENV=development\" && set \"NEXT_DIST_DIR=.next\" && next dev --port 3000",
    "build": "set \"NODE_ENV=production\" && set \"NEXT_DIST_DIR=.next-prod\" && next build",
    "start": "set \"NODE_ENV=production\" && set \"NEXT_DIST_DIR=.next-prod\" && next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests",
    "test:unit:coverage": "c8 --check-coverage --lines 20 --functions 20 --branches 10 --statements 20 --reporter=text-summary node --test tests",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.1.6",
    "@tanstack/react-query": "^5.99.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.9.4",
    "lucide-react": "^0.468.0",
    "next": "^15.5.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shared-contracts": "*",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "c8": "^10.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "next": {
      "postcss": "^8.5.10"
    }
  }
}

